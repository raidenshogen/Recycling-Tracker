
type Users {
    id : ID,
    username:String,
    email:String
}

type Household{
    id: ID,
    name:String,
    country:String,
    address:String ,
    JoinDate:String,
    TotalPoints: Float,
    recyclingEvents:[RecyclingEvent]
}

type RecyclingEvent{
    id:ID,
    MaterialType:String,
    WeightKG:Float ,
    recyclingDate:String,
    EcoPoints: Float,
    household:Household
}
type Mutation{
    CreateHousehold(household: Householdinput):Household,
    CalculateTotalPoints(housholdId:ID):Float,
    SavelogsForHouseholds:Boolean,
    CalculateTotalWeights(household:Householdinput):Float,
    AddRecyclingEvent(RE:RecyclingEventinput ):RecyclingEvent,
    DeleteRecyclingEvent(RE:RecyclingEventinput):Boolean,
    CalculateTotalEcoPoints(weight:Int):Float,
    TotalCommunityWeight:Float
}
type Query{
    findAllRecyclingEventsByHouseholdId(id:ID):[RecyclingEvent],
    HighestTotalPoints:Household
}



input Householdinput{
    name:String,
    country:String,
    address:String ,
    JoinDate:String,

}
input RecyclingEventinput{
    id:ID,
    MaterialType:String,
    WeightKG:Float ,
    recyclingDate:String,

}
